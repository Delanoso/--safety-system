# Copy this file to .env.local and fill in your values.
# Restart the dev server after changing .env.local.

# Bootstrap super users (production). Login with these emails/passwords creates or uses super users. Do not commit real passwords.
# Option A – JSON array (recommended for multiple super users):
# BOOTSTRAP_SUPER_USERS=[{"email":"erichvandenheuvel5@gmail.com","password":"YOUR_PASSWORD"},{"email":"demouser1@gmail.com","password":"YOUR_PASSWORD"}]
# Option B – single user:
# BOOTSTRAP_SUPER_USER_EMAIL=admin@example.com
# BOOTSTRAP_SUPER_USER_PASSWORD=your_secure_password

# Database – REQUIRED for Vercel. Use Vercel Postgres, Neon, or Supabase.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Base URL – REQUIRED for Vercel. Set to your production URL.
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Cloudinary – required for certificate uploads, incident images, docs, etc.
# Get these from https://cloudinary.com/console (Dashboard + API Keys)
#
# Option A: Single URL (recommended)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
#
# Option B: Separate vars
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# WhatsApp — used for signature requests, vote links, PPE signing, contractor uploads, etc.
# Messages open in WhatsApp (wa.me) with the link pre-filled. Default country code for local numbers: 27 (South Africa).
# WHATSAPP_DEFAULT_COUNTRY_CODE=27

# Legacy email (no longer used for sending documents/signatures in the app)
# RESEND_API_KEY=
# RESEND_FROM=
# SMTP_HOST=

# OpenAI – for AI-generated risk assessments. Get key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxx

# PDF generation: path to Chrome or Edge .exe (optional). If PDF download fails with "browser not found", set this.
# Windows: right‑click your Chrome/Edge shortcut → Open file location → copy path to the .exe
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Microsoft\Edge\Application\msedge.exe

# Alternative: SMTP (legacy — not used for outbound links)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_password
# SMTP_FROM=your@email.com

# Sentry – error tracking and monitoring (optional). Get DSN from https://sentry.io
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=xxx
